import java.util.List;
/**
 * T3 自动化测试：覆盖 T1(搜索) 和 T2(删除) 的修复。
 * 必须使用 Assert 类进行断言，不可修改原有的 LibraryTest.java。
 */
public class ExtraTest {

    // ==========================================
    // 覆盖 T1: 按书名搜索支持包含匹配（5组测试）
    // ==========================================
    public void testSearchFix() {
        // 建立带种子数据的对象
        Library library = new Library(true);

        // 1. search("Java") 期望 1 条
        List<Book> res1 = library.search("Java");
        Assert.assertEquals(1, res1.size(), "搜索'Java'应返回1条");

        // 2. search("入门") 期望 1 条
        List<Book> res2 = library.search("入门");
        Assert.assertEquals(1, res2.size(), "搜索'入门'应返回1条");

        // 3. search("张") 期望 0 条（只匹配书名，不匹配作者）
        List<Book> res3 = library.search("张");
        Assert.assertEquals(0, res3.size(), "搜索'张'应返回0条，不能搜作者");

        // 4. search("java") 期望 0 条（区分大小写）
        List<Book> res4 = library.search("java");
        Assert.assertEquals(0, res4.size(), "搜索'java'应返回0条，区分大小写");

        // 5. search("数据结构") 期望 1 条
        List<Book> res5 = library.search("数据结构");
        Assert.assertEquals(1, res5.size(), "搜索'数据结构'应返回1条");
    }

    // ==========================================
    // 覆盖 T2: 删除图书与自增编号不复用
    // ==========================================
    public void testDeleteAndAutoIncrement() {
        Library library = new Library(true); // 初始: 1, 2, 3

        // 1. 删除编号2的图书 -> 期望提示"删除成功"
        String deleteResult = library.deleteBook(2);
        Assert.assertEquals("删除成功", deleteResult, "删除存在的图书应提示'删除成功'");

        // 2. 删除后 listAll() 不含该书 -> 只剩 1, 3，总数2本
        List<Book> listAfterDelete = library.listAll();
        Assert.assertEquals(2, listAfterDelete.size(), "删除后剩余图书数应为2");
        for (Book b : listAfterDelete) {
            Assert.assertTrue(b.getId() != 2, "列表中不应存在编号为2的图书");
        }

        // 3. 删除后 add() 编号不复用（核心考点！）
        // 删掉了2，下次添加必须分配编号4，不能是2！
        Book newBook = library.add("新书", "测试作者", 30.0);
        Assert.assertEquals(4, newBook.getId(), "删除后添加，编号应延续为4，不可复用2");

        // 4. 重复删除 -> 提示"图书编号不存在"
        String repeatDelete = library.deleteBook(2);
        Assert.assertEquals("图书编号不存在", repeatDelete, "重复删除应提示'图书编号不存在'");

        // 5. 删空后添加编号延续
        // 当前还有 1, 3, 4。依次删除 1, 3, 4
        library.deleteBook(1);
        library.deleteBook(3);
        library.deleteBook(4);

        // 此时库为空
        Assert.assertEquals(0, library.listAll().size(), "全部删除后应为空");

        // 此时再加新书，编号应为5（因为历史最大值是4，即使删光了编号也不能回退）
        Book lastBook = library.add("最后测试", "作者", 50.0);
        Assert.assertEquals(5, lastBook.getId(), "删空后添加，编号应继续延续为5");
    }

    // ==========================================
    // 兼容测试运行器（如果没有自动发现机制，可手动运行）
    // ==========================================
    public static void main(String[] args) {
        System.out.println("开始运行 ExtraTest 测试...");
        ExtraTest test = new ExtraTest();

        try {
            test.testSearchFix();
            System.out.println("T1 搜索修复测试 通过！");

            test.testDeleteAndAutoIncrement();
            System.out.println("T2 删除与编号不复用测试 通过！");

            System.out.println("所有新增测试全部通过！");
        } catch (Throwable e) {
            System.err.println("测试失败: " + e.getMessage());
            e.printStackTrace();
        }
    }
}